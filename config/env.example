# AI Car Finder MVP - Environment Variables
# Copy to .env and fill in values

# ===========================================
# DATABASE (PostgreSQL - Neon/Supabase)
# ===========================================
DATABASE_URL=postgres://user:password@host:5432/ai_car_finder

# ===========================================
# LLM (OpenAI gpt-4o-mini)
# ===========================================
OPENAI_API_KEY=sk-proj-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=200

# ===========================================
# AUTHENTICATION (JWT)
# ===========================================
JWT_SECRET=your-32-character-secret-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# ADMIN CREDENTIALS
# ===========================================
ADMIN_EMAIL=admin@ai-car-finder.app
ADMIN_PASSWORD=securepassword123

# ===========================================
# SERVER
# ===========================================
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://ai-car-finder.app

# ===========================================
# FILE UPLOAD
# ===========================================
FILE_UPLOAD_MAX_MB=50

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_USER=100
RATE_LIMIT_ADMIN=50
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
